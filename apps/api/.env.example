DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=
API_URL=https://your-domain.railway.app
# Must be a Railway WORKSPACE token, not a project token — project tokens
# are scoped to one existing environment and can't create/manage the PR
# environments this API provisions directly (see ADR-009). Lets this API
# create/delete Railway environments and set their variables without ever
# touching Railway's own dashboard for routine PR preview work.
RAILWAY_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# This platform's own Neon account key — lets this API list/create Neon
# projects and fork/delete PR-preview branches (see ADR-008/009).
NEON_API_KEY=
# Org-wide credential shared by every endorsed project's reusable
# preview.yml workflow (issue #52) — never a per-repo secret.
CI_SERVICE_TOKEN=
# Generate with: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=
RESEND_API_KEY=
WEB_URL=http://localhost:5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=msocietybot
ANTHROPIC_API_KEY=

# Optional — only needed if a tier is set to a DeepSeek model
DEEPSEEK_API_KEY=
VOYAGE_API_KEY=

# Web search for the research sub-agent (https://exa.ai). Optional —
# without it, web_search returns a 'not configured' message.
EXA_API_KEY=
